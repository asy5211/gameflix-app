# Copy this file to ".env" (same folder) and fill in the values. ".env" is git-ignored.
# Classroom-only values: do not reuse a real password.
MYSQL_DATABASE=gameflix
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_USER=gameflix_user
MYSQL_PASSWORD=change_this_app_password
MYSQL_HOST_PORT=3307
APP_HOST_PORT=8080

# Generate in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
