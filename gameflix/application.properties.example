# Copy this file to src/main/resources/application-local.properties (git-ignored)
# and replace the placeholder values. Alternatively set the same values as environment variables
# (MYSQL_USER, MYSQL_PASSWORD, JWT_SECRET, ...) in your IntelliJ run configuration.

DB_URL=jdbc:mysql://localhost:3306/gameflix?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USER=gameflix_user
MYSQL_PASSWORD=change-me

# Generate with:  openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES

CORS_ALLOWED_ORIGIN=http://localhost:3000
